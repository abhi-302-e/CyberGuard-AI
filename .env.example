# CyberGuard AI - Environment Configuration Example
CYBERGUARD_ENV=development
CYBERGUARD_LOG_LEVEL=INFO

# Networking & Ports
CYBERGUARD_UI_PORT=5000
CYBERGUARD_API_PORT=8000

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///cyberguard_enterprise.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://cyberguard_user:cyberguard_pass@db:5432/cyberguard_db

# Security & Cryptographic Keys
CYBERGUARD_SECRET=cg-autonomous-defense-key-2026

# Optional External Message Queue / Caching
REDIS_URL=redis://localhost:6379/0

# Optional AI Model Credentials
OPENAI_API_KEY=
GEMINI_API_KEY=

